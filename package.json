{
  "name": "ledgerline",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.18.3",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "e2e": "playwright test",
    "break": "tsx --conditions=react-server scripts/break.ts",
    "test:rule": "tsx scripts/test-rule.ts",
    "evidence": "pnpm db:seed && vitest run --reporter=default --reporter=json --outputFile.json=reports/vitest.json; pnpm db:seed && playwright test; tsx scripts/trust.ts",
    "eval:live": "vitest run -c vitest.live.config.ts --disableConsoleIntercept",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:role": "tsx scripts/role-password.ts",
    "db:seed": "tsx scripts/seed.ts fresh",
    "db:seed:live": "tsx scripts/seed-live.ts",
    "preset": "tsx scripts/preset.ts",
    "demo-desk": "tsx scripts/make-demo-desk.ts",
    "cron:reminders": "tsx scripts/run-reminders.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.132.1",
    "@tanstack/react-table": "^9.2.8",
    "@vercel/blob": "^2.8.1",
    "bcryptjs": "^3.0.3",
    "clsx": "^2.1.1",
    "jose": "^6.2.12",
    "lucide-react": "^1.53.0",
    "mammoth": "^1.13.0",
    "next": "15.5.27",
    "pdf-lib": "1.17.1",
    "pg": "^8.23.1",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "recharts": "^3.10.1",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.7.0",
    "xlsx": "file:vendor/xlsx-0.20.3.tgz",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/eslintrc": "^3",
    "@playwright/test": "^1.64.0",
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^3.0.0",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "docx": "^9.9.0",
    "dotenv": "^18.0.6",
    "eslint": "^9",
    "eslint-config-next": "15.5.27",
    "prettier": "^3.9.10",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.3"
  }
}
